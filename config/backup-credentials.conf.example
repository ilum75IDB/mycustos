# MySQL credentials for mycustos — copy to config/backup-credentials.conf.
#
#   chmod 600 config/backup-credentials.conf
#
# This is a MySQL option file, read by the MySQL client and the backup engines
# (never by the shell). Use a dedicated account with only the privileges
# required by the chosen backup engine.
# Do not commit the real file: only this template belongs in version control.

[client]
user=backup_user
password=CHANGE_ME
# socket=/var/run/mysqld/mysqld.sock
