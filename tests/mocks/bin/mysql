#
# Test double of the mysql client: records its arguments and the login file
# it would read in $MC_MOCK_LOG.
#
# Without $MC_MOCK_MYSQL_RESPONSES: prints $MC_MOCK_MYSQL_OUTPUT (if set) and
# exits with $MC_MOCK_MYSQL_RC (default 0), whatever the query.
#
# With $MC_MOCK_MYSQL_RESPONSES (a file): answers per query. One line per
# query, tab-separated:  SQL <TAB> RC <TAB> OUTPUT
# OUTPUT is printed with printf %b, so "\t" separates columns and "\n" rows.
# A query not in the file fails like a server error (rc 1).
{
  printf 'login_file=%s\n' "${MYSQL_TEST_LOGIN_FILE-<unset>}"
  if [ -n "${MYSQL_TEST_LOGIN_FILE:-}" ] && [ -f "$MYSQL_TEST_LOGIN_FILE" ] && [ ! -s "$MYSQL_TEST_LOGIN_FILE" ]; then
    echo 'login_file_empty=yes'
  fi
  printf 'arg=%s\n' "$@"
} >> "${MC_MOCK_LOG:-/dev/null}"

if [ -z "${MC_MOCK_MYSQL_RESPONSES:-}" ]; then
  [ -z "${MC_MOCK_MYSQL_OUTPUT:-}" ] || printf '%s\n' "$MC_MOCK_MYSQL_OUTPUT"
  exit "${MC_MOCK_MYSQL_RC:-0}"
fi

sql=''
while [ $# -gt 0 ]; do
  case "$1" in
    -e) sql=${2:-}; shift ;;
    --execute=*) sql=${1#*=} ;;
  esac
  shift
done
while IFS=$'\t' read -r q rc out; do
  [ "$q" = "$sql" ] || continue
  [ -z "$out" ] || printf '%b\n' "$out"
  exit "$rc"
done < "$MC_MOCK_MYSQL_RESPONSES"
printf 'ERROR 1064 (42000): mock: unexpected query: %s\n' "$sql" >&2
exit 1
