# Test double of the mysql client: records its arguments and the login file
# it would read in $MC_MOCK_LOG, then exits with $MC_MOCK_MYSQL_RC (default 0).
{
  printf 'login_file=%s\n' "${MYSQL_TEST_LOGIN_FILE-<unset>}"
  if [ -n "${MYSQL_TEST_LOGIN_FILE:-}" ] && [ -f "$MYSQL_TEST_LOGIN_FILE" ] && [ ! -s "$MYSQL_TEST_LOGIN_FILE" ]; then
    echo 'login_file_empty=yes'
  fi
  printf 'arg=%s\n' "$@"
} >> "${MC_MOCK_LOG:-/dev/null}"
exit "${MC_MOCK_MYSQL_RC:-0}"
