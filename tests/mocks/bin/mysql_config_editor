# Test double of mysql_config_editor: "print --login-path=NAME" shows an entry
# only when NAME is listed in $MC_MOCK_LOGIN_PATHS (space separated).
[ "${1:-}" = print ] || exit 1
name=${2#--login-path=}
for p in ${MC_MOCK_LOGIN_PATHS:-}; do
  if [ "$p" = "$name" ]; then
    printf '[%s]\nuser = "backup_user"\npassword = *****\n' "$name"
    exit 0
  fi
done
exit 0
